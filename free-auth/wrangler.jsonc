{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "labdam-free-approval",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "labdam-membership",
      "database_id": "REPLACE_WITH_REAL_FREE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
