{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "labdam-protected-services",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
